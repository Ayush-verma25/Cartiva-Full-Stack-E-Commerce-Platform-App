generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id         Int        @id @default(autoincrement())
  store_id   Int?
  name       String     @db.VarChar(255)
  slug       String     @db.VarChar(255)
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  stores     stores?    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products[]
}

model orders {
  id               Int       @id @default(autoincrement())
  order_number     String    @unique @db.VarChar(100)
  store_id         Int?
  customer_id      String?   @db.Uuid
  customer_name    String    @db.VarChar(255)
  customer_email   String    @db.VarChar(255)
  customer_phone   String?   @db.VarChar(50)
  shipping_address Json
  items            Json
  subtotal         Decimal   @db.Decimal(10, 2)
  discount         Decimal?  @default(0) @db.Decimal(10, 2)
  shipping_cost    Decimal?  @default(0) @db.Decimal(10, 2)
  total            Decimal   @db.Decimal(10, 2)
  coupon_code      String?   @db.VarChar(50)
  payment_status   String?   @default("pending") @db.VarChar(50)
  payment_method   String?   @default("cod") @db.VarChar(50)
  order_status     String?   @default("placed") @db.VarChar(50)
  tracking_number  String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  stores           stores?   @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_number], map: "idx_orders_number")
  @@index([store_id], map: "idx_orders_store")
}

model products {
  id               Int         @id @default(autoincrement())
  store_id         Int?
  category_id      Int?
  name             String      @db.VarChar(255)
  description      String?
  price            Decimal     @db.Decimal(10, 2)
  compare_at_price Decimal?    @db.Decimal(10, 2)
  sku              String?     @db.VarChar(100)
  stock            Int?        @default(0)
  images           Json?       @default("[]")
  variants         Json?       @default("[]")
  status           String?     @default("active") @db.VarChar(50)
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  categories       categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  stores           stores?     @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id], map: "idx_products_store")
}

model stores {
  id                      Int          @id @default(autoincrement())
  merchant_id             String?      @db.Uuid
  name                    String       @db.VarChar(255)
  slug                    String       @unique @db.VarChar(255)
  logo_url                String?
  banner_url              String?
  description             String?
  currency                String?      @default("USD") @db.VarChar(10)
  status                  String?      @default("active") @db.VarChar(50)
  shipping_fee            Decimal?     @default(0) @db.Decimal(10, 2)
  free_shipping_threshold Decimal?     @default(0) @db.Decimal(10, 2)
  hero_style              String?      @default("hero1") @db.VarChar(50)
  accent_color            String?      @default("#059669") @db.VarChar(50)
  created_at              DateTime?    @default(now()) @db.Timestamp(6)
  categories              categories[]
  orders                  orders[]
  products                products[]

  @@index([slug], map: "idx_stores_slug")
}
